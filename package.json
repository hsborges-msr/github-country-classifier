{
  "name": "@hsborges-msr/github-country-classifier",
  "version": "0.2.0",
  "packageManager": "yarn@1.22.22",
  "description": "Infer the country of a GitHub user from the public fields of their profile, in Node or in the browser (multilingual-e5-small, ONNX), with the model included",
  "license": "MIT",
  "author": "Hudson Silva Borges",
  "homepage": "https://github.com/hsborges-msr/github-country-classifier#readme",
  "bugs": {
    "url": "https://github.com/hsborges-msr/github-country-classifier/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsborges-msr/github-country-classifier.git"
  },
  "keywords": [
    "github",
    "country",
    "location",
    "geolocation",
    "classifier",
    "onnx",
    "onnxruntime",
    "browser"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.17.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "model",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "shx rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo/tsconfig.json",
    "test": "vitest run",
    "demo": "vite",
    "demo:build": "vite build",
    "demo:preview": "vite preview",
    "prepack": "yarn build",
    "smoke:pack": "sh scripts/smoke-pack.sh"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "onnxruntime-node": "^1.30.0",
    "onnxruntime-web": "^1.30.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    },
    "onnxruntime-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/request-error": "^7.1.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "i18n-iso-countries": "^7.14.0",
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.30.0",
    "shx": "^0.4.0",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8",
    "vitest": "^3.2.4",
    "world-atlas": "^2.0.2"
  }
}
